# Copy to .env and fill from your Supabase project (Project Settings → API).
# The anon key is safe to ship in the browser; Row-Level Security protects data.
# Never put the service_role key or DB password in a VITE_ var — those are server-only.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
